# Server Runtime
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Security Secret (32+ random characters in production; never commit real secrets)
SESSION_PEPPER=""

# Self-Contained SQLite & Direct Media Storage (set DATA_DIR=/var/data when using a Render Disk)
DATA_DIR="./data"
SQLITE_PATH="./data/zephyrix.db"
UPLOADS_DIR="./data/uploads"

# Gemini AI Assistant (server-side only; optional)
GEMINI_API_KEY=""

# ZEGOCLOUD Messaging & Audio/Video/Group Calls (Server Secret stays strictly on backend)
ZEGO_APP_ID=""
ZEGO_SERVER_SECRET=""
