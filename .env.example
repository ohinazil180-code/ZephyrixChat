# Server Runtime
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Optional Cross-Origin Frontend (e.g. GitHub Pages URL: https://<username>.github.io)
FRONTEND_URL=""
CORS_ORIGIN=""
VITE_API_URL=""

# Security Secret (32+ random characters in production; never commit real secrets)
SESSION_PEPPER=""

# PostgreSQL Database URL (recommended on Render/Neon/Supabase so accounts & chats persist across restarts)
# Leave empty in local development to use built-in SQLite automatically
DATABASE_URL=""

# Self-Contained SQLite Fallback & Direct Media Storage (set DATA_DIR=/var/data when using a Render Disk)
DATA_DIR="./data"
SQLITE_PATH="./data/zephyrix.db"
UPLOADS_DIR="./data/uploads"

# Gemini AI Assistant (server-side only; optional)
GEMINI_API_KEY=""

# ZEGOCLOUD Messaging & Audio/Video/Group Calls (Server Secret stays strictly on backend)
ZEGO_APP_ID=""
ZEGO_SERVER_SECRET=""

# Optional Auto-Seeded Super Admin Account (set in Render Env Vars; never commit real passwords)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
